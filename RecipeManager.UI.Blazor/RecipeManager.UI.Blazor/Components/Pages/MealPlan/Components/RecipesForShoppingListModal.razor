@using RecipeManager.UI.Blazor.Components.Common
@using RecipeManager.UI.Blazor.Features.Ingredients
@using RecipeManager.UI.Blazor.Features.Recipes

<style>
    .dialog-container {
        width: 750px; 
        max-height: 600px;
    }

    .title-header {
        width: 450px;
    }
    
    .servings-header {
        width: 250px;
    }

    .recipes-list {
        max-height: 450px; 
        overflow-y: auto;
    }

    .recipe-image {
        align-self: center; 
        margin-top: 15px;
    }

    .recipe-title {
        width: 375px; 
        margin-top: 10px;
    }

    .servings-input {
        width: 250px; 
        margin-top: 15px;
    }
</style>

<MudDialog Class="dialog-container">
    <DialogContent>
        <MudForm T="ShoppingListRequest">
            <MudStack>
                <MudStack Row="true">                
                    <MudText Typo="Typo.h6" Class="title-header">Title</MudText>
                    <MudText Typo="Typo.h6" Class="servings-header">Number of servings</MudText>
                </MudStack>

                <div class="recipes-list">
                    @foreach (var recipe in ShoppingListRequest.Recipes)
                    {
                        <MudStack Row="true">
                            <ImageComponent ImageSource="@recipe.ImageUrl" MaxHeight="75" MaxWidth="75" ImageStyle="align-self: center; margin-top: 15px;" />
                            <MudText Typo="Typo.h6" Class="recipe-title">@recipe.Title</MudText>
                            <MudTextField T="int" For="@(() => recipe.NumberOfServings)" @bind-Value="@recipe.NumberOfServings" Class="servings-input" />
                        </MudStack>
                    }
                </div>
            </MudStack>
        </MudForm> 
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Close">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public IEnumerable<RecipeForShoppingListModel> Recipes { get; set; } = [];

    private ShoppingListRequest ShoppingListRequest { get; set; } = new();

    protected override void OnInitialized()
    {
        ShoppingListRequest.Recipes = Recipes.ToList();
        base.OnInitialized();
    }

    private void Close() 
    {
        MudDialog.Close(DialogResult.Ok(ShoppingListRequest));
    }

    private void Cancel() => MudDialog.Cancel();
}
