@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Features.RecipeCategories;
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Models
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Services

@page "/admin/recipe-categories"

@inject IRecipeCategoryService RecipeCategoryService

<MudPaper Class="common-page-container" Outlined="true">
    <MudText Typo="Typo.h6" Align="Align.Center">Recipe categories</MudText>

    <MudStack Row=true Spacing="3" Style="margin-left: 15px; margin-right: 15px">
        <MudTextField Label="Name" For="@(() => newCategoryModel.Name)" @bind-Value="newCategoryModel.Name"/>
        <MudSelect T="RecipeCategoryType" Label="Category" @bind-Value="newCategoryModel.CategoryType" Required="true">
            @foreach (var key in categoryTypes)
            {
                <MudSelectItem Value="@key.Key">@key.Value</MudSelectItem>
            }
        </MudSelect>

        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Edge="Edge.End" OnClick="CreateCategory"/>
    </MudStack>

    <RecipeCategoryListComponent CategoriesPage="categoriesPage" ShowLoadingBar="!categoriesLoaded"/>
</MudPaper>

@code {
    private HateoasResponse<RecipeCategoryPageModel> categoriesPage = new();
    private RecipeCategoryForCreateModel newCategoryModel = new();
    private bool categoriesLoaded = false;
    private readonly Dictionary<RecipeCategoryType, string> categoryTypes = RecipeCategoryTypeExtensions.GetCategoryTypes();

    override protected async Task OnInitializedAsync()
    {
        categoriesPage = await RecipeCategoryService.GetCategories(1, 10, null);
        categoriesLoaded = true;
    }

    private async Task CreateCategory()
    {
        await RecipeCategoryService.CreateCategory(newCategoryModel);
        categoriesPage = await RecipeCategoryService.GetCategories(1, 10, null);
    }
}
