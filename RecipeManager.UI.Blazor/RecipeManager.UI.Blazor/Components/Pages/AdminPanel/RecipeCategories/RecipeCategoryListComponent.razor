@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Features.RecipeCategories
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Models
@using RecipeManager.UI.Blazor.Components.Common.DialogMessage
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Services

@inject IRecipeCategoryService RecipeCategoryService
@inject IDialogMessageService DialogService

<MudTable @ref="table" T="HateoasResponse<RecipeCategoryModel>" ServerData="RefreshTable" Items="CategoriesPage.Item.Categories" Loading="ShowLoadingBar" LoadingProgressColor="Color.Info">
    <ToolBarContent>
        <MudSelect T="int" @bind-Value="categoryTypeToSearch" style="margin-right: 5px">
            @foreach (var type in categoryTypes)
            {
                <MudSelectItem Value="@type.Key">@type.Value</MudSelectItem>
            }
        </MudSelect>
        
        <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.Search" OnClick="() => OnSearchClick()"></MudIconButton>
    </ToolBarContent>
    <ColGroup>
        <col style="width: 50%;" />
        <col style="width: 30%;" />
        <col style="width: 20%;" />
    </ColGroup>
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Category</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Item.Name</MudTd>
        <MudTd DataLabel="Category">@context.Item.Type</MudTd>
        <MudTd DataLabel="Actions">
            <MudIconButton Disabled="@(!context.Links.Any(link => link.Rel == HateoasConstants.Delete))" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Delete" OnClick="() => DeleteCategory(context)"></MudIconButton>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <div class="d-flex flex-column align-center">
            <MudTablePager>

            </MudTablePager>
        </div>
    </PagerContent>
</MudTable>

@code {
    [Parameter]
    public HateoasResponse<RecipeCategoryPageModel> CategoriesPage { get; set; } = new();

    [Parameter]
    public bool ShowLoadingBar { get; set; } = true;

    private MudTable<HateoasResponse<RecipeCategoryModel>> table;
    private Dictionary<int, string> categoryTypes { get; set; }
    private int categoryTypeToSearch = -1;

    protected async override Task OnInitializedAsync()
    {
        categoryTypes = new Dictionary<int, string>() { { -1, "All" } };
        RecipeCategoryTypeExtensions.GetCategoryTypes().ToList().ForEach(ct => categoryTypes.Add((int)ct.Key, ct.Value));
    }

    private async Task DeleteCategory(HateoasResponse<RecipeCategoryModel> selectedItem)
    {
        if (await DialogService.ShowDeleteConfirmationMessage())
        {
            await RecipeCategoryService.DeleteCategory(selectedItem.Links.First(link => link.Rel == HateoasConstants.Delete).Href);
        }
    }

    private async Task OnSearchClick()
    {
        await table.ReloadServerData();
    }

    private async Task<TableData<HateoasResponse<RecipeCategoryModel>>> RefreshTable(TableState state, CancellationToken cancellationToken)
    {
        ShowLoadingBar = true;
        CategoriesPage = await RecipeCategoryService.GetCategories(state.Page + 1, state.PageSize, categoryTypeToSearch == -1 ? null : categoryTypeToSearch);
        ShowLoadingBar = false;

        return new TableData<HateoasResponse<RecipeCategoryModel>>() { TotalItems = CategoriesPage.Item.TotalCount, Items = CategoriesPage.Item.Categories };
    }
}
