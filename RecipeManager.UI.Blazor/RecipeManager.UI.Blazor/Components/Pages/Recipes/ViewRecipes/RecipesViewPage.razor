@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Features.RecipeCategories
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Models
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Services
@using RecipeManager.UI.Blazor.Features.Recipes.GetRecipes
@using RecipeManager.UI.Blazor.Features.Recipes.Services

@page "/recipes"

@inject IRecipeService RecipeService
@inject IRecipeCategoryService RecipeCategoryService

<MudOverlay @bind-Visible="overlayVisible" DarkBackground AutoClose="true" OnClosed="OnOverlayClosed" />

<MudPaper Class="common-page-container" Outlined="true">
    <MudGrid Style="width:1800px;">
        <MudItem Style="display: flex; width:inherit;" Class="recipe-image-container">
            <MudStack Row="true" class="recipe-image-stack">
                @if(filtersCount > 0)
                {
                    <MudBadge Content="filtersCount" Overlap="true" Class="mx-6 my-4">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterList" Color="Color.Primary" Style="justify-self:center"
                                       OnClick="@(() => ToggleDrawer())"/>
                    </MudBadge>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.FilterList" Color="Color.Primary" Style="justify-self:center"
                                   OnClick="@(() => ToggleDrawer())"/>
                }
                <MudText Typo="Typo.h6" Style="align-content: center">Recipes</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Style="justify-self:center"
                               OnClick="@(() => CreateNewRecipe())" Disabled="@isAddDisabled" />
            </MudStack>
        </MudItem>

        <MudCollapse Expanded="@isDrawerOpen" Style="z-index: 100;" Class="top-drawer">
            <div style="" class="overlay-wrapper">
                <div class="blocker">
                @foreach (var categoryType in categoryDropdowns.Keys)
                {
                    <MudItem class="recipe-category-item">
                        <MudText Typo="Typo.subtitle2" Class="d-flex align-center recipe-category-item-title">@categoryType.ToFriendlyString():</MudText>
                        <MudChipSet T="RecipeCategoryForDropdownModel" Variant="Variant.Text" AllClosable="false" CheckMark="false" SelectionMode="SelectionMode.MultiSelection"
                                    Color="Color.Primary">
                            @foreach (var category in categoryDropdowns[categoryType])
                            {
                                <MudChip @bind-Selected="@category.IsSelected" T="RecipeCategoryForDropdownModel" Value="category">@category.Name</MudChip>
                            }
                        </MudChipSet>
                    </MudItem>
                }

                <MudItem class="recipe-ingredients-title">
                    <MudText Typo="Typo.subtitle2">Ingredients</MudText>
                </MudItem>

                </div>
            </div>
        </MudCollapse>
    </MudGrid>

    <RecipeListComponent RecipesPage="recipesPage" SelectedCategories="selectedCategories" ShowLoadingBar=recipesLoaded></RecipeListComponent>
</MudPaper>


@code {
    private HateoasResponse<RecipesPageModel> recipesPage { get; set; } = new();
    private Dictionary<RecipeCategoryType, IEnumerable<RecipeCategoryForDropdownModel>> categoryDropdowns { get; set; } = new();
    private IEnumerable<RecipeCategoryForDropdownModel> selectedCategories => categoryDropdowns.Values.SelectMany(s => s);
    private bool overlayVisible = false;
    private bool recipesLoaded = false;
    private bool isAddDisabled = false;
    private bool isDrawerOpen = false;
    private int filtersCount => selectedCategories.Count(c => c.IsSelected);

    private void ToggleDrawer() 
    {
        isDrawerOpen = !isDrawerOpen;
        overlayVisible = isDrawerOpen;
    }

    public void OnOverlayClosed()
    {
        ToggleDrawer();
    }

    private void CreateNewRecipe()
    {
        RecipeService.OpenCreateRecipePage();
    }

    override protected async Task OnInitializedAsync()
    {
        recipesPage = await RecipeService.GetRecipesPage([], [], 1, 10);
        categoryDropdowns = await RecipeCategoryService.GetCategoriesForFiltering();
        recipesLoaded = true;
        isDrawerOpen = false;
        isAddDisabled = !recipesPage.Links.Any(link => link.Rel == HateoasConstants.Create);
        StateHasChanged();
    }
}
