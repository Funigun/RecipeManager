@using RecipeManager.UI.Blazor.Components.Common
@using RecipeManager.UI.Blazor.Components.Extensions
@using RecipeManager.UI.Blazor.Features.Recipes.Models
@using RecipeManager.UI.Blazor.Features.Recipes.Validators

<style>
    .step-input-container {
        margin-right: 10px; 
        margin-left: 50px; 
        width: 620px !important;
    }

    .step-input {
        width: 620px;
    }

    .action-button {
        margin-right: 10px;
    }

    .step-details-header {
        width:850px;
    }

    .step-details-header-empty {
        width:850px; 
        border: none; 
        height: 0px;
    }

    .step-row-container {
        display: flex; 
        gap: 1rem;
    }
    
    .step-image-container {
        width: 500px; 
        height: 500px; 
        justify-self:center; 
        margin-top: 15px;
    }

    .step-image {
        width:500px; 
        height: 500px; 
        border: 1px solid; 
        margin-top: 15px;
    }
</style>

<MudForm T="RecipeSectionModel" Model="RecipeSection">
    @if (Mode.IsCreateOrEditMode())
    {
        <MudStack Row=true Spacing="3">
            <div class="step-input-container">
                <MudTextField T="string" Label="Step Description*" @bind-Value="newStep.Description" Class="step-input"></MudTextField>
            </div>
        
            <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="AddStep" Disabled="@(string.IsNullOrEmpty(newStep.Description))" Class="action-button"></MudIconButton>
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="RemoveSelectedSteps" Disabled="!selectedSteps.Any()" Class="action-button"></MudIconButton>
        </MudStack>
    }
    <MudTable T="RecipeStepModel" Items="RecipeSection.Steps" @bind-selectedItems="selectedSteps" FixedHeader="true" MultiSelection="@Mode.IsCreateOrEditMode()" SelectionChangeable="@Mode.IsCreateOrEditMode()">
        <HeaderContent>
            @if(Mode.IsCreateOrEditMode())
            {
                <MudTh Class="step-details-header">Details</MudTh>
            }
            else
            {
                <MudTh Class="step-details-header-empty"></MudTh>
            }
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <div class="step-row-container">
                    <span><strong>@context.Order.</strong></span>
                    <span>@context.Description</span>
                </div>

                <div class="step-image-container">
                    @if (!string.IsNullOrEmpty(@context.ImageUrl))
                    {
                        <MudImage Src="@context.ImageUrl" Alt="Image" Class="step-image" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Class="step-image" />                   }
                </div>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudForm>


@code {
    [Parameter]
    public RecipeSectionModel RecipeSection { get; set; } = new();

    [Parameter]
    public EventCallback<RecipeSectionModel> OnDataChanged { get; set; }

    [CascadingParameter]
    public FormMode Mode { get; set; }

    private HashSet<RecipeStepModel> selectedSteps = new();
    private RecipeStepModel newStep = new();

    private async Task AddStep()
    {
        RecipeSection.Steps.Add(new()
        {
            Order = RecipeSection.Steps.Count + 1,
            Description = newStep.Description
        });

        newStep.Description = string.Empty;

        await OnDataChanged.InvokeAsync(RecipeSection);
    }

    private async Task RemoveSelectedSteps()
    {
        foreach (RecipeStepModel stepModel in selectedSteps)
        {
            RecipeSection.Steps.Remove(stepModel);
        }

        int stepOrder = 1;

        foreach (RecipeStepModel step in RecipeSection.Steps)
        {
            step.Order = stepOrder;
            stepOrder++;
        }

        await OnDataChanged.InvokeAsync(RecipeSection);
    }
}
