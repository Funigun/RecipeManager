@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Components.Common
@using RecipeManager.UI.Blazor.Components.Common.DialogMessage
@using RecipeManager.UI.Blazor.Components.Extensions
@using RecipeManager.UI.Blazor.Features.Ingredients
@using RecipeManager.UI.Blazor.Features.Ingredients.Services
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Models
@using RecipeManager.UI.Blazor.Features.RecipeCategories.Services
@using RecipeManager.UI.Blazor.Features.Recipes
@using RecipeManager.UI.Blazor.Features.Recipes.Models
@using RecipeManager.UI.Blazor.Features.Recipes.Services
@using RecipeManager.UI.Blazor.Features.Recipes.Validators
@using RecipeManager.UI.Blazor.Features.Units
@using RecipeManager.UI.Blazor.Features.Units.Services

@inject IUnitService UnitService
@inject IRecipeService RecipeService
@inject IIngredientService IngredientService
@inject IRecipeCategoryService RecipeCategoryService
@inject IDialogMessageService DialogService
@inject NavigationManager NavigationManager


<MudForm @ref="Form" Model="RecipeModel" ReadOnly="Mode.IsViewMode()" Validation="@(validator.ValidateValue)" @bind-IsValid="@isSubmitEnabled" @rendermode="RenderMode.InteractiveAuto">
    <MudStack Spacing="5">
        <div style="align-self: center; width: 100%;">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudTextField Required Label="Title" For="@(() => RecipeModel.Item.Title)" @bind-Value="RecipeModel.Item.Title" />

                @if (Mode.IsViewMode() && @RecipeModel.Links.FirstOrDefault(link => link.Rel == HateoasConstants.Update) != null)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" OnClick="ToggleEditRecipe"/>
                }
                else if (Mode.IsEditMode())
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="Color.Primary" OnClick="ToggleEditRecipe" />
                }
            </MudStack>

            <MudStack Row="true">
                @if (Mode.IsCreateOrEditMode())
                {
                    <MudIconButton Icon="@Icons.Material.Filled.FileUpload" Color="Color.Primary" />
                }
            </MudStack>

            <MudStack Row="true" Style="margin-top: 25px; max-height:500px">
                <div style="width: 500px; height: 500px; justify-self:center;">
                    @if(RecipeModel.Item.ImageUrl != null)
                    {
                        <MudImage Src="RecipeModel.Item.ImageURL" Alt="Recipe Image" Style="max-width: 500px; max-height:500px; margin-top: 15px;" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Style="width:500px; height: 500px; border: 1px solid; margin-top: 15px;" />
                    }
                </div>
                <div style="margin-top: 10px; width: 700px; overflow-y: auto">
                    <MudStack Spacing="5">
                        <MudTextField AutoGrow Label="Description" MaxLength="500" For="@(() => RecipeModel.Item.Description)" @bind-Value="RecipeModel.Item.Description" />
                        
                            <MudAutocomplete T="IngredientForDropdownModel" Label="Assigned ingredient" @bind-Value="RecipeModel.Item.Ingredient" ShowProgressIndicator="true"
                                             SearchFunc="SearchIngredients" ToStringFunc="@(e => e == null ? null : e.Name)" style="width: 300px; padding-top: 15px;" Clearable=true/>

                        <MudStack Row="true" Style="padding-top: 15px;">
                            <MudText Style="align-content: end" Color="@(categoriesMessages != null && categoriesMessages.Any() ? Color.Error : Color.Default)">Categories*</MudText>

                            @if (Mode.IsCreateOrEditMode())
                            {
                                <MudGrid Style="padding: 0px; margin-left: 20px;">
                                    <MudItem xs="9" Style="padding: 0px">
                                        <MudAutocomplete T="RecipeCategoryForDropdownModel" Label="Find category" ResetValueOnEmptyText="true" ShowProgressIndicator="true"
                                                         SearchFunc="SearchCategories" ToStringFunc="@(e => e == null ? null : e.Name)" ValueChanged="OnSelectedCategoryChanged" />
                                    </MudItem>
                                    <MudItem xs="3" Style="padding: 0px">
                                        <MudIconButton Disabled="@isAddCategoryDisabled" Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Edge="Edge.End" OnClick="AddCategory" />
                                    </MudItem>
                                </MudGrid>
                            }
                        </MudStack>

                        <MudStack Spacing="5">
                            <div style="max-height: 80px; overflow-y:auto">
                                <MudChipSet T="RecipeCategoryForDropdownModel" AllClosable="@Mode.IsCreateOrEditMode()" OnClose="RemoveCategory">
                                    @foreach (var category in RecipeModel.Item.Categories)
                                    {
                                        <MudChip Text="@category.Name" Value="category" Color="Color.Primary" />
                                    }
                                </MudChipSet>
                            </div>

                            <CustomValidationSummary ErrorMessages="@categoriesMessages" />
                        </MudStack>
                    </MudStack>
                </div>
            </MudStack>
        </div>

        <MudPaper Outlined="true" Style="margin-top: 25px">
            <MudExpansionPanel Text="Recipe Details" >
                <MudStack Spacing="5">
                    <MudGrid>
                        <MudItem xs="3">
                            <MudTextField T="double" Label="Amount*" For="@(() => RecipeModel.Item.Amount.Amount)" @bind-Value="RecipeModel.Item.Amount.Amount" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudSelect T="Guid" Label="Unit*" For="@(() => RecipeModel.Item.Amount.Unit.Id)" @bind-value="RecipeModel.Item.Amount.Unit.Id">
                                @foreach (var unit in units)
                                {
                                    <MudSelectItem Value="@unit.Id">@unit.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField T="byte" Required Label="Number of servings" For="@(() => RecipeModel.Item.NumberOfServings)" @bind-Value="RecipeModel.Item.NumberOfServings" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudSelect Required T="RecipeDifficulty" Label="Difficulty" For="@(() => RecipeModel.Item.Difficulty)" @bind-Value="RecipeModel.Item.Difficulty">
                                @foreach (var difficulty in Difficulties)
                                {
                                    <MudSelectItem Value="@difficulty.Key">@difficulty.Value</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>

                    <MudGrid Style="margin-top: 15px;">
                        <MudItem xs="3"><MudTextField T="double" Label="Kcal"></MudTextField>        </MudItem>
                        <MudItem xs="3"><MudTextField T="double" Label="Carbohydrates"></MudTextField> </MudItem>
                        <MudItem xs="3"><MudTextField T="double" Label="Proteins"></MudTextField>      </MudItem>
                        <MudItem xs="3"><MudTextField T="double" Label="Fats"></MudTextField>          </MudItem>
                    </MudGrid>
                </MudStack>
            </MudExpansionPanel>
        </MudPaper>

        <MudPaper Outlined="true" Style="margin-top: 25px">
            <MudExpansionPanel Text="Ingredients" >
                <RecipeIngredientsListComponent Ingredients="RecipeModel.Item.Ingredients" Units="units" OnDataChanged="HandleIngredientsChanged"></RecipeIngredientsListComponent>
            </MudExpansionPanel>
        </MudPaper>


        <MudTabs Outlined="true" Position="Position.Top" Style="margin-top: 25px;" Centered="true" Rounded="true" Border="true"
                 ApplyEffectsToContainer="true" Class="mt-8" PanelClass="pa-6">
            @foreach (RecipeSectionModel recipeSection in RecipeModel.Item.Sections)
            {
                    <MudTabPanel Text="@recipeSection.SectionHeader">
                        <CascadingValue Value="Mode">
                            <RecipeSectionStepsListComponent RecipeSection="recipeSection" OnDataChanged="HandleSectionChanged" />
                        </CascadingValue>

                        <CustomValidationSummary ErrorMessages="@(RecipeSectionErrors != null && RecipeSectionErrors.ContainsKey(@recipeSection.SectionType) ? RecipeSectionErrors[@recipeSection.SectionType] : [])" />
                    </MudTabPanel>
            }
        </MudTabs>
       
        @if (Mode.IsCreateMode() || (Mode.IsEditMode() && @RecipeModel.Links.FirstOrDefault(link => link.Rel == HateoasConstants.Update) != null))
        {
            <MudGrid Class="mt-4">
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="false">
                        Back
                    </MudButton>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end">
                    @if (Mode.IsEditMode() && @RecipeModel.Links.FirstOrDefault(link => link.Rel == HateoasConstants.Delete) != null)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteRecipe" Style="margin-right: 20px">
                            Delete
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveRecipe">
                        Save
                    </MudButton>
                </MudItem>
            </MudGrid>
        }

        <CustomValidationSummary ErrorMessages="@errorMessages" /> 
     </MudStack>
</MudForm>


@code {
    [Parameter]
    public HateoasResponse<RecipeForManageModel> RecipeModel { get; set; } = new();

    [Parameter]
    public EventCallback<HateoasResponse<RecipeForManageModel>> OnValidSubmit { get; set; }

    [Parameter]
    public FormMode Mode { get; set; }

    private MudForm Form { get; set; } = default!;

    private IEnumerable<IngredientForDropdownModel> ingredients = [];
    private IEnumerable<UnitForDropdownModel> units { get; set; } = [];

    private Dictionary<RecipeSectionType, List<string>> RecipeSectionErrors = [];
    private Dictionary<RecipeDifficulty, string> Difficulties { get; set; } = RecipeDifficultyExtensions.GetRecipeDifficulties();
    private readonly RecipeModelValidator validator = new();
    private readonly RecipeSectionValidator sectionValidator = new();
    private readonly RecipeIngredientsValidator ingredientsValidator = new();

    private bool isSubmitEnabled = false;
    private IEnumerable<string> errorMessages = [];
    private IEnumerable<string> ingredientsMessages = [];
    private IEnumerable<string> categoriesMessages = [];

    private IEnumerable<RecipeCategoryForDropdownModel> categories = [];
    private RecipeCategoryForDropdownModel selectedCategory = new();
    private string toggleCategoriesIcon = Icons.Material.Filled.KeyboardArrowDown;
    private bool showCategories = false;
    private bool isAddCategoryDisabled = true;

    protected override async Task OnInitializedAsync()
    {
        units = await UnitService.GetUnitsForDropdown();
        RecipeSectionErrors = RecipeModel.Item.Sections.ToDictionary(section => section.SectionType, section => new List<string>());
        StateHasChanged();
    }

    private async Task HandleIngredientsChanged(ICollection<RecipeIngredientModel> ingredients)
    {
        RecipeModel.Item.Ingredients = ingredients;
        ingredientsMessages = (await ingredientsValidator.ValidateAsync(ingredients)).Errors.Select(e => e.ErrorMessage);
    }

    private async Task HandleSectionChanged(RecipeSectionModel section)
    {
        RecipeSectionModel existingSection = RecipeModel.Item.Sections.First(s => s.SectionType == section.SectionType);
        existingSection.Steps = section.Steps;
        RecipeSectionErrors[section.SectionType] = (await sectionValidator.ValidateAsync(section)).Errors.Select(e => e.ErrorMessage).ToList();
    }

    private async Task<IEnumerable<IngredientForDropdownModel>> SearchIngredients(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value) || !string.IsNullOrEmpty(value) && value != RecipeModel.Item.Ingredient?.Name)
        {
            ingredients = await IngredientService.GetIngredientsForDropdownModel(value, cancellationToken);
        }

        return ingredients;
    }

    private async Task<IEnumerable<RecipeCategoryForDropdownModel>> SearchCategories(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrEmpty(value) || !string.IsNullOrEmpty(value) && value != selectedCategory?.Name)
        {
            categories = await RecipeCategoryService.GetCategoriesForDropdown(value);
        }

        return categories;
    }

    private void AddCategory()
    {
        RecipeModel.Item.Categories.Add(selectedCategory);
        isAddCategoryDisabled = true;
    }

    private void RemoveCategory(MudChip<RecipeCategoryForDropdownModel> chip)
    {
        RecipeModel.Item.Categories.Remove(chip.Value!);
        isAddCategoryDisabled = selectedCategory is null || RecipeModel.Item.Categories.Any(category => category.Id == selectedCategory.Id);
        categoriesMessages = RecipeModel.Item.Categories.Any() ? [] : ["Recipe requires at least one category"];
    }

    private void ToggleCategories()
    {
        showCategories = !showCategories;
        toggleCategoriesIcon = showCategories
                             ? Icons.Material.Filled.KeyboardArrowUp
                             : Icons.Material.Filled.KeyboardArrowDown;
    }

    private void OnSelectedCategoryChanged(RecipeCategoryForDropdownModel value)
    {
        selectedCategory = value;
        isAddCategoryDisabled = selectedCategory is null || RecipeModel.Item.Categories.Any(category => category.Id == selectedCategory.Id);
    }

    private async Task SaveRecipe()
    {
        if (await ValidateForm())
        {
            if (Mode.IsEditMode())
            {
                await RecipeService.UpdateRecipe(RecipeModel.Links.First(link => link.Rel == HateoasConstants.Update).Href, RecipeModel.Item);
            }
            else
            {
                await RecipeService.CreateRecipe(RecipeModel.Item);
            }
        }
    }

    private async Task<bool> ValidateForm()
    {
        await Form.Validate();

        foreach(RecipeSectionModel section in RecipeModel.Item.Sections)
        {
            RecipeSectionErrors[section.SectionType] = (await sectionValidator.ValidateAsync(section)).Errors.Select(e => e.ErrorMessage).ToList();
        }

        ingredientsMessages = (await ingredientsValidator.ValidateAsync(RecipeModel.Item.Ingredients)).Errors.Select(e => e.ErrorMessage);

        categoriesMessages = RecipeModel.Item.Categories.Any() ? [] : ["Recipe requires at least one category"];

        return Form.IsValid && RecipeSectionErrors.Values.All(errors => !errors.Any()) && !ingredientsMessages.Any() && !categoriesMessages.Any();
    }

    private async Task DeleteRecipe()
    {
        if (await DialogService.ShowDeleteConfirmationMessage())
        {
            await RecipeService.DeleteRecipe(RecipeModel.Links.First(link => link.Rel == HateoasConstants.Delete).Href);
        }
    }

    private async Task ToggleEditRecipe(MouseEventArgs args)
    {
        if (Mode.IsEditMode() && (await DialogService.CancelOperationConfirmed()))
        {
            NavigationManager.Refresh(true);
        }
        else
        {
            Mode = FormMode.Edit;
            StateHasChanged();
        }
    }
}
