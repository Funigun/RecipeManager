@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Features.Recipes.GetRecipes
@using RecipeManager.UI.Blazor.Features.Recipes.Services

@page "/recipes"

@inject IRecipeService RecipeService

<div style="width:100vw; position:relative; left:50%; right:50%; margin-left:-50vw;">
    <MudPaper Class="mt-6" Height="100%" Width="100%" Style="border: none" Outlined=true>
        <MudGrid Justify="Justify.FlexStart" Style="width:100%; position: sticky; top: 0; z-index: 1000; align-items:center">
            <MudItem xs="2" sm="1" Style="margin-left: 25px;">
                <MudIconButton Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
            </MudItem>
            <MudItem xs="8" sm="10" Style="display: flex; justify-content: center; align-items: center;">
                <MudStack Row="true" Style="gap: 12px; align-items:center;">
                    <MudText Typo="Typo.h6">Recipes</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="@(() => CreateNewRecipe())" Disabled="@isAddDisabled" />
                </MudStack>
            </MudItem>
        </MudGrid>
    
        <MudDrawerContainer Class="mud-height-full" >
            <MudDrawer @bind-Open="_drawerOpen" Elevation="6">
                <MudStack Style="margin-left: 15px">
                    <MudText Typo="Typo.subtitle2">Categories</MudText>
                    <MudText Typo="Typo.subtitle2">Ingredients</MudText>
                </MudStack>
            </MudDrawer>

            <RecipeListComponent RecipesPage="recipesPage" ShowLoadingBar=recipesLoaded></RecipeListComponent>
        </MudDrawerContainer >
    </MudPaper>
</div>

@code {
    private HateoasResponse<RecipesPageModel> recipesPage { get; set; } = new();
    private bool recipesLoaded = false;
    private bool isAddDisabled = false;
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void CreateNewRecipe()
    {
        RecipeService.OpenCreateRecipePage();
    }

    override protected async Task OnInitializedAsync()
    {
        recipesPage = await RecipeService.GetRecipesPage([], [], 1, 10);
        recipesLoaded = true;
        isAddDisabled = !recipesPage.Links.Any(link => link.Rel == HateoasConstants.Create);
    }
}
