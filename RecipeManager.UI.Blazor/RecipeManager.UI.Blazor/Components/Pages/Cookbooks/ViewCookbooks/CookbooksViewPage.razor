@page "/cookbooks"
@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Features.Cookbooks
@using RecipeManager.UI.Blazor.Features.Cookbooks.GetCookbooks
@using RecipeManager.UI.Blazor.Features.Cookbooks.Services

@inject ICookbookService CookbookService;

<style>
    .main-grid {
        width: 1500px;
    }

    .header-row {
        gap: 12px; 
        width:inherit; 
        justify-items:center; 
        justify-content:center;
    }

    .header-text {
        align-content: center;
    }

    .add-button {
        justify-self:center;
    }

    .header-item {
        display: flex; 
        width:inherit;
    }
</style>

<MudPaper Class="common-page-container" Outlined="true">
    <MudGrid Class="main-grid">
        <MudItem Class="header-item">
            <MudStack Row="true" Class="header-row">
                <MudText Typo="Typo.h6" Class="header-text">Cookbooks</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Class="add-button"
                               OnClick="@(() => CreateNewCookbook())" Disabled="@isAddDisabled" />
            </MudStack>
        </MudItem>
    </MudGrid>

    <CookbookListComponent CookbooksPage="CookbooksPage" ShowLoadingBar="!cookbooksLoaded"></CookbookListComponent>
</MudPaper>

@code {
    private HateoasResponse<CookbooksPageModel> CookbooksPage { get; set; } = new();
    private bool isAddDisabled = true;
    private bool cookbooksLoaded = false;

    private void CreateNewCookbook()
    {
        CookbookService.OpenCreateCookbookPage();
    }

    protected override async Task OnInitializedAsync()
    {
        CookbooksPage = await CookbookService.GetCookbooksPage(1, 10);
        isAddDisabled = !CookbooksPage.Links.Any(link => link.Rel == HateoasConstants.Create);
        cookbooksLoaded = true;

        StateHasChanged();
    }
}
