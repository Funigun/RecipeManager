@using MudBlazor
@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Components.Common
@using RecipeManager.UI.Blazor.Features.Cookbooks.GetCookbooks
@using RecipeManager.UI.Blazor.Features.Cookbooks.Services

@inject ICookbookService CookbookService;



<MudGrid T="HateoasResponse<CookbooksPage>" Items="CookbooksPage.Item.Recipes" Loading="ShowLoadingBar"
         Virtualize="true" FixedHeader="true" Class="mt-6 cookbooks-grid">

    @for(int i = 0; i < CookbooksPage.Item.Cookbooks.Count; i++)
    {
        HateoasResponse<CookbookModel> cookbook = CookbooksPage.Item.Cookbooks[i];
            
        <MudItem Class="cookbook-item">
            <MudPaper Class="d-flex align-center justify-center mud-width-full py-8 cookbook-container" Outlined=true>
                <MudStack Spacing="5">
                    @if (!string.IsNullOrEmpty(cookbook.Item.CoverImageUrl))
                    {
                        <MudImage Src="@cookbook.Item.CoverImageUrl" Class="cookbook-cover-image" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.QuestionMark" Size="Size.Large" Class="cookbook-cover-image"
                                       Color="Color.Primary" OnClick="(() => OpenCookbook(cookbook))"></MudIconButton>
                    }
                    <MudText Typo="Typo.h6" Class="cookbook-title">@cookbook.Item.Title</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudPagination Class="d-flex align-center cookbooks-pagination" SelectedChanged="PageChanged"
               Selected="CookbooksPage.Item.Page"
               Count="CookbooksPage.Item.TotalCount / CookbooksPage.Item.PageSize"
               ShowPreviousButton="CookbooksPage.Links.Any(link => link.Rel == HateoasConstants.Previous)"
               ShowNextButton="CookbooksPage.Links.Any(link => link.Rel == HateoasConstants.Next)"
               ShowFirstButton="true"
               ShowLastButton="true" />

@code {
    [Parameter]
    public HateoasResponse<CookbooksPageModel> CookbooksPage { get; set; } = new();

    [Parameter]
    public bool ShowLoadingBar { get; set; } = true;

    private async Task PageChanged(int selectedPage)
    {
        CookbooksPage = await CookbookService.GetCookbooksPage(selectedPage, CookbooksPage.Item.PageSize);
        StateHasChanged();
    }

    private void OpenCookbook(HateoasResponse<CookbookModel> cookbook)
    {
        CookbookService.OpenUpdateCookbookPage(cookbook.Item.Id);
    }
}
