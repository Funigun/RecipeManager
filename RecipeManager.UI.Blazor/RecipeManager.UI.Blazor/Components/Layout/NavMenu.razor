@using Microsoft.AspNetCore.Components.Authorization

<MudPaper MaxWidth="300">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2">
        <MudNavLink Match="NavLinkMatch.All" Href="" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
        <MudNavLink Href="cookbooks" Icon="@Icons.Material.Filled.Book">Cookbooks</MudNavLink>
        <MudNavLink Href="recipes" Icon="@Icons.Material.Filled.List">Recipes</MudNavLink>
        <MudNavLink Href="ingredients" Icon="@Icons.Material.Filled.Kitchen">Ingredients</MudNavLink>
        <AuthorizeView Roles="Admin">
            <MudNavGroup Title="Admin Panel" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded=false>
                <MudNavLink Href="admin/measurement-units" Icon="@Icons.Material.Filled.Timer">Units</MudNavLink>
                <MudNavLink Href="admin/recipe-categories" Icon="@Icons.Material.Filled.Dining">Recipe Categories</MudNavLink>
                <MudNavLink Href="admin/ingredient-categories" Icon="@Icons.Material.Filled.Spa">Ingredient Categories</MudNavLink>
            </MudNavGroup>
        </AuthorizeView>
    </MudNavMenu>
</MudPaper>