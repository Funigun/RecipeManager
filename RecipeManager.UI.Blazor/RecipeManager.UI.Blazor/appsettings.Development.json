{
  "RecipesApi": {
    "BaseUrl": "https://localhost:7001"
  },

  "IdentityApi": {
    "BaseUrl": "https://localhost:7002"
  },

  "DetailedErrors": true,
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:8081"
        }
      },
      {
        "Name": "OpenTelemetry"
      }
    ]
  },

  "OpenTelemetry": {
    "Seq": {
      "LogsExportEndpoint": "http://localhost:8081/ingest/otlp/v1/logs",
      "TracesExportEndpoint": "http://localhost:8081/ingest/otlp/v1/traces"
    }
  }
}
