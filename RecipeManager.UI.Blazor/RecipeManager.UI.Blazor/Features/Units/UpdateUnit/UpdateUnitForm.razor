@using FluentValidation
@using MudBlazor
@using RecipeManager.UI.Blazor.Brokers.HateoasModel
@using RecipeManager.UI.Blazor.Components.Common
@using RecipeManager.UI.Blazor.Features.Units.Services

@inject IUnitService UnitService

@if (isLoaded)
{
    <MudForm Model="@unitModel.Item" Validation="@(validator.ValidateValue)" @bind-IsValid="@isSubmitEnabled">
        <MudText Typo="Typo.h5" Class="mb-4">Update Unit</MudText>

        <MudTextField Label="Name" For="@(() => unitModel.Item.Name)" @bind-Value="unitModel.Item.Name" Required="true" />

        <MudTextField Label="Short Name" For="@(() => unitModel.Item.ShortName)" @bind-Value="unitModel.Item.ShortName" />

        <MudTextField Label="Group" For="@(() => unitModel.Item.Group)" @bind-Value="unitModel.Item.Group" Required="true" />

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitUnit" Class="mt-4" FullWidth>
            Update Unit
        </MudButton>

        <CustomValidationSummary ErrorMessages="@errorMessages" />
    </MudForm>
}

@code {
    [Parameter]
    public string UnitId { get; set; }

    private HateoasResponse<UnitForUpdateModel> unitModel = new();
    private readonly UnitForUpdateValidator validator = new();
    private bool isSubmitEnabled = false;
    private IEnumerable<string> errorMessages = [];
    private bool isLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Guid.TryParse(UnitId, out Guid a))
            {
                unitModel = await UnitService.GetUnitById(a);
            }
            isLoaded = true;
            StateHasChanged();
        }
    }

    private async Task SubmitUnit()
    {
        await UnitService.UpdateUnit(Guid.Parse(UnitId), unitModel.Item);
        errorMessages = UnitService.ResponseBody.GetAllErrors();
    }
}