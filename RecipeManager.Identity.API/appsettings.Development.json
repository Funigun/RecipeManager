{
  "ConnectionStrings": {
    "RecipeManager": "Server=.;Database=RecipeManagerIdentity;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "ServerUrl": "http://localhost:8081"
        }
      },
      {
        "Name": "OpenTelemetry"
      }
    ]
  },

  "JwtSettings": {
    "Key": "S0m3_R4nd0m_Te5t_K3y_F0r_JWT_G3n3rati0n!",
    "Duration": "15",
    "Issuer": "Recipe Manager Identity API Issuer",
    "Audience": "Recipe Manager Identity API Audience",
    "RefreshTokenKey": "S0m3_R4nd0m_Te5t_Refre5h_T0ken_K3y_F0r_JWT_G3n3rati0n!",
    "RefreshTokenDurationInDays": "5"
  },

  "OpenTelemetry": {
    "Seq": {
      "LogsExportEndpoint": "http://localhost:8081/ingest/otlp/v1/logs",
      "TracesExportEndpoint": "http://localhost:8081/ingest/otlp/v1/traces"
    }
  }
}
