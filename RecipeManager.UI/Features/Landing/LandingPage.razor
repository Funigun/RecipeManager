@page "/"

<PageTitle>Welcome</PageTitle>

<section class="rm-landing">
    <div class="rm-landing-content">
        <PageHeading Title="Welcome to Recipe Manager" />
        <MudText Typo="Typo.body1" Class="rm-landing-copy">
            Keep your recipes organized, plan meals, and make your kitchen easier to manage.
        </MudText>
        <div class="rm-landing-actions">
            <MudButton Href="register" Variant="Variant.Filled" Color="Color.Primary">Create account</MudButton>
            <MudButton Href="login" Variant="Variant.Outlined" Color="Color.Primary">Sign in</MudButton>
        </div>
    </div>
</section>
