@inherits LayoutComponentBase
@inject IStringLocalizer<MainLayout> Localizer

<MudThemeProvider Theme="@ThemeService.Current.Theme" IsDarkMode="@ThemeService.Current.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Class="@(IsAppArea ? "rm-app-bar" : "rm-app-bar rm-public-app-bar")" Elevation="1">
        <MudText Typo="Typo.h6">
            <a class="rm-brand" href="@HomeHref">Recipe Manager</a>
        </MudText>

        @if (IsAppArea)
        {
            <MudSpacer />
            <nav class="rm-primary-nav" aria-label="Main navigation">
                <NavLink class="rm-nav-link" href="dishes">Dishes</NavLink>
                <NavLink class="rm-nav-link" href="recipes">Recipes</NavLink>
                <NavLink class="rm-nav-link" href="cookbooks">Cookbooks</NavLink>
                <NavLink class="rm-nav-link" href="meal-plans">Meal plans</NavLink>
                <NavLink class="rm-nav-link" href="profile">Profile</NavLink>
            </nav>
            <MudMenu Class="rm-mobile-nav">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Inherit"
                                   aria-label="Open main navigation" />
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="dishes">Dishes</MudMenuItem>
                    <MudMenuItem Href="recipes">Recipes</MudMenuItem>
                    <MudMenuItem Href="cookbooks">Cookbooks</MudMenuItem>
                    <MudMenuItem Href="meal-plans">Meal plans</MudMenuItem>
                    <MudMenuItem Href="profile">Profile</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
        else
        {
            <div class="rm-public-spacer" aria-hidden="true"></div>
            <nav class="rm-public-nav" aria-label="Main navigation">
                <NavLink class="rm-nav-link" href="./" Match="NavLinkMatch.All">@Localizer["Home"]</NavLink>
                <a class="rm-nav-link" href="./#features">@Localizer["Features"]</a>
            </nav>
            <MudMenu Class="rm-mobile-nav">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Inherit"
                                   aria-label="Open main navigation" />
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="./">@Localizer["Home"]</MudMenuItem>
                    <MudMenuItem Href="./#features">@Localizer["Features"]</MudMenuItem>
                </ChildContent>
            </MudMenu>
        }

        <div class="@(IsAppArea ? "rm-header-actions" : "rm-header-actions rm-public-header-actions")">
            @if (!IsAppArea)
            {
                <div class="rm-public-account-actions">
                    <MudButton Class="rm-public-auth-button"
                               Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small">@Localizer["SignIn"]</MudButton>
                    <MudButton Class="rm-public-auth-button"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small">@Localizer["Register"]</MudButton>
                </div>
            }

            <MudMenu Class="rm-theme-menu">
                <ActivatorContent>
                    <MudTooltip Text="Theme">
                        <MudIconButton Icon="@Icons.Material.Filled.Palette"
                                       Color="Color.Inherit"
                                       aria-label="Theme" />
                    </MudTooltip>
                </ActivatorContent>
                <ChildContent>
                    @foreach (ThemeDefinition theme in ThemeCatalog.Themes)
                    {
                        <MudMenuItem OnClick="@(() => OnThemeSelectionChanged(theme.Id))">@theme.Name</MudMenuItem>
                    }
                </ChildContent>
            </MudMenu>
        </div>
    </MudAppBar>

    <MudMainContent Class="rm-main-content">
        <div class="rm-shell">
            @if (IsAdminArea)
            {
                <aside class="rm-admin-sidebar" aria-label="Admin navigation">
                    <MudText Typo="Typo.overline" Class="rm-admin-nav-label">Admin catalogs</MudText>
                    <MudNavMenu Class="rm-admin-nav">
                        <MudNavLink Href="admin" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Overview</MudNavLink>
                        <MudNavLink Href="admin/units" Icon="@Icons.Material.Filled.Straighten">Units</MudNavLink>
                        <MudNavLink Href="admin/ingredients" Icon="@Icons.Material.Filled.Restaurant">Global ingredients</MudNavLink>
                        <MudNavLink Href="admin/ingredient-categories" Icon="@Icons.Material.Filled.Category">Ingredient categories</MudNavLink>
                        <MudNavLink Href="admin/recipe-categories" Icon="@Icons.Material.Filled.RestaurantMenu">Recipe categories</MudNavLink>
                        <MudNavLink Href="admin/shopping-list-categories" Icon="@Icons.Material.Filled.ShoppingBasket">Shopping-list categories</MudNavLink>
                        <MudNavLink Href="admin/meal-categories" Icon="@Icons.Material.Filled.Restaurant">Meal categories</MudNavLink>
                    </MudNavMenu>
                </aside>
            }

            <main class="rm-page-container">
                @Body
            </main>
        </div>

        @if (CurrentRoute.Length == 0)
        {
            <footer class="rm-landing-footer">
                <span>@Localizer["FooterText"]</span>
            </footer>
        }
    </MudMainContent>
</MudLayout>

@code {
    [Inject]
    private ThemeService ThemeService { get; set; } = null!;

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private string CurrentRoute
    {
        get
        {
            string route = Navigation.ToBaseRelativePath(Navigation.Uri);
            int queryOrFragmentIndex = route.IndexOfAny(['?', '#']);
            return (queryOrFragmentIndex >= 0 ? route[..queryOrFragmentIndex] : route).Trim('/');
        }
    }
    private string HomeHref => IsAppArea ? "kitchen" : "./";

    private bool IsAdminArea =>
        CurrentRoute.Equals("admin", StringComparison.OrdinalIgnoreCase) ||
        CurrentRoute.StartsWith("admin/", StringComparison.OrdinalIgnoreCase);

    private bool IsAppArea =>
        IsAdminArea ||
        CurrentRoute is "kitchen" or "dishes" or "recipes" or "cookbooks" or "meal-plans" or "profile";

    private Task OnThemeSelectionChanged(string themeId)
    {
        ThemeService.SelectTheme(themeId);
        return Task.CompletedTask;
    }
}
